# Backend (FastAPI / Northflank)
# Copy this file to backend/.env and fill in your secrets there.
# IMPORTANT: Put API keys in backend/.env — NOT in this file.

APP_NAME=Lakshay.ai API
APP_ENV=production
DEBUG=false

# Primary LLM provider: gemini | openrouter | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter fallback (used when LLM_PROVIDER=gemini and Gemini quota/errors occur)
# Get a key at https://openrouter.ai/keys
LLM_FALLBACK_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://www.lakshay.website
OPENROUTER_APP_NAME=Lakshay.ai

# Or use OpenRouter as the primary provider:
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# OpenAI (only if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=60

# Comma-separated allowed browser origins (Vercel frontend URL)
CORS_ORIGINS=https://your-domain.vercel.app,http://localhost:3000

# Supabase analytics — required in production
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
